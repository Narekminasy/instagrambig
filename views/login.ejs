<!DOCTYPE html>
<html lang="hy">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="login_page.title">Login | Dental Clinic</title>
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

<header>
    <nav>
        <a href="/users/home" class="logo" data-i18n="nav.logo">
            🦷 Dental Clinic
        </a>

        <div class="lang-dropdown">
            <button class="lang-dropbtn" id="currentLangBtn">🌐 HY</button>
            <div class="lang-dropdown-content">
                <a href="#" onclick="changeLanguage('hy')">🇦🇲 HY</a>
                <a href="#" onclick="changeLanguage('en')">🇺🇸 EN</a>
                <a href="#" onclick="changeLanguage('ru')">🇷🇺 RU</a>
            </div>
        </div>


        <ul>
            <li><a href="/users/home" data-i18n="nav.home">Home</a></li>
            <li><a href="/users/register" data-i18n="nav.register">Register</a></li>
            <li><a href="/users/login" data-i18n="nav.login">Login</a></li>
            <li><a href="/users/users" data-i18n="nav.profile">Profile</a></li>
            <li><a href="/users/index" data-i18n="nav.blog">Blog</a></li>
            <li><a href="/users/About" data-i18n="nav.about">About Us</a></li>
            <li><a href="/users/Contact" data-i18n="nav.contact">Contact</a></li>
        </ul>
    </nav>
</header>

<main>
    <section class="form-box">

        <div id="loginSection">
            <h1 data-i18n="login_page.heading">Login</h1>
            <p data-i18n="login_page.subheading">Welcome back to Dental Clinic Community</p>
            <h3 id="errorLogin" style="color: red; display: none;">ddd</h3>

            <input id="email" type="email" placeholder="Email" data-i18n-placeholder="login_page.placeholder_email">
            <input id="password" type="password" placeholder="Password" data-i18n-placeholder="login_page.placeholder_password">

            <button id="loginBtn" data-i18n="login_page.btn_login">Login</button>
            <button id="forgot" data-i18n="login_page.btn_forgot">forgot password?</button>
        </div>

        <div id="forgotSection" style="display: none;">
            <h1 data-i18n="login_page.forgot_heading">Reset Password</h1>
            <p data-i18n="login_page.forgot_subheading">Enter your email and a new secure password</p>
            <h2 id="errorForgot" style="color: red; display: none;"></h2>

            <input id="forgotEmail" type="email" placeholder="Enter your Email" data-i18n-placeholder="login_page.placeholder_enter_email">
            <input id="newPasswordInput" type="password" placeholder="Enter New Password" data-i18n-placeholder="login_page.placeholder_new_password">

            <button id="forgotSubmitBtn" data-i18n="login_page.btn_change_password">Change Password</button>
            <button id="backToLoginBtn" style="background-color: #6c757d;" data-i18n="login_page.btn_back">Back to Login</button>
        </div>

    </section>
</main>

<footer>
    <ul>
        <li><a href="/users/about" data-i18n="footer.about">About Us</a></li>
        <li><a href="/users/Contact" data-i18n="footer.contact">Contact</a></li>
        <li><a href="/users/privacy" style="color: white;" data-i18n="footer.privacy">Privacy</a></li>
    </ul>
    <p class="p_fist" style="color: white" data-i18n="footer.copy">
        © 2026 Dental Clinic
    </p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/js/login.js"></script>

</body>
</html>
