<!DOCTYPE html>
<html lang="hy">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | Dental Student</title>

    <link rel="stylesheet" href="/css/main.css">
</head>


<body>


<header>

    <nav>

        <a href="/users/home" class="logo">
            🦷 Dental Student
        </a>

        <ul>

            <li>
                <a href="/users/home">
                    Home
                </a>
            </li>

            <li>
                <a href="/users/register">
                    Register
                </a>
            </li>

            <li>
                <a href="/users/login">
                    Login
                </a>
            </li>

            <li>
                <a href="/users/index">
                    Blog
                </a>
            </li>

            <li>
                <a href="/users/About">
                    About Us
                </a>
            </li>

            <li>
                <a href="/users/Contact">
                    Contact
                </a>
            </li>

        </ul>


    </nav>

</header>




<main>

    <section class="form-box">

        <!-- ԱՅՍ ՄԱՍԸ ԼՈԳԻՆԻ ՀԱՄԱՐ Է -->
        <div id="loginSection">
            <h1>Login</h1>
            <p>Welcome back to Dental Student Community</p>

            <input id="email" type="email" placeholder="Email">
            <input id="password" type="password" placeholder="Password">

            <button id="loginBtn">Login</button>
            <button id="forgot">forgot password?</button>
        </div>

        <div id="forgotSection" style="display: none;">
            <h1>Reset Password</h1>
            <p>Enter your email and a new secure password</p>

            <input id="forgotEmail" type="email" placeholder="Enter your Email">
            <input id="newPasswordInput" type="password" placeholder="Enter New Password">

            <button id="forgotSubmitBtn">Change Password</button>
            <button id="backToLoginBtn" style="background-color: #6c757d;">Back to Login</button>
        </div>

    </section>

</main>






<footer>


    <ul>

        <li>
            <a href="/users/about">
