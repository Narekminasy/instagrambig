<!DOCTYPE html>
<html lang="hy">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dental Clinic chat</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            background: #f0f2f5;
        }

        .chat-box {
            max-width: 500px;
            margin: 40px auto;
            background: white;
            padding: 24px;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        h2 {
            display: flex;
            align-items: center;
            font-size: 20px;
            margin-top: 0;
            color: #333;
        }

        #messages {
            list-style-type: none;
            padding: 15px;
            height: 350px;
            overflow-y: auto;
            border: 1px solid #e4e6eb;
            margin-bottom: 15px;
            background: #fdfdfd;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        #messages li {
            padding: 10px 14px !important;
            margin-bottom: 0 !important;
            border-radius: 18px !important;
            max-width: 75%;
            font-size: 15px;
            line-height: 1.4;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

        #messages li[id^="msg-"] {
            background: #dcf8c6 !important;
            align-self: flex-end;
            border: none !important;
            border-bottom-right-radius: 4px !important;
        }

        #messages li:not([id^="msg-"]) {
            background: #f1f0f0 !important;
            align-self: flex-start;
            border: none !important;
            border-bottom-left-radius: 4px !important;
        }

        .delete-btn {
            opacity: 0.6;
            transition: opacity 0.2s;
        }
        .delete-btn:hover {
            opacity: 1;
        }

        .inputs {
            display: flex;
            gap: 10px;
        }

        input {
            flex: 1;
            padding: 12px 16px;
            border: 1px solid #ccd0d5;
            border-radius: 22px;
            outline: none;
            font-size: 14px;
            transition: border 0.2s;
        }
        input:focus {
            border-color: #007bff;
        }

        button:not(.delete-btn) {
            padding: 12px 24px;
            background: #24a0ed;
            color: white;
            border: none;
            border-radius: 22px;
            cursor: pointer;
            font-weight: 600;
            transition: background 0.2s;
        }
        button:not(.delete-btn):hover {
            background: #1a83cb;
        }
    </style>
</head>
<body>
<div class="chat-box">
    <h2>chat <span id="status-dot" style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: #ccc; margin-left: 8px;"></span></h2>

    <ul id="messages">
        <% if (typeof history !== 'undefined' && history.length > 0) { %>
            <% history.forEach(function(msg) { %>
                <% if (String(msg.userId) === String(currentUserId)) { %>
                    <li id="msg-<%= msg.id %>" style="background: #e1ffb1; display: flex; justify-content: space-between; align-items: center; padding: 8px; margin-bottom: 5px; border-radius: 4px;">
                        <span>Ես: <%= msg.message %></span>
                        <button class="delete-btn" data-id="<%= msg.id %>" style="background: none; border: none; color: red; cursor: pointer; font-weight: bold; margin-left: 10px;">✕</button>
                    </li>
                <% } else { %>
                    <li style="background: #ffffff; text-align: left; padding: 8px; margin-bottom: 5px; border-radius: 4px; border: 1px solid #eee;">
                        Դիմացինը: <%= msg.message %>
                    </li>
                <% } %>
            <% }); %>
        <% } %>
    </ul>


    <div class="inputs">
        <input type="text" id="messageInput" placeholder="Write message">
        <button id="sendBtn">Send</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    const myId = "<%= currentUserId %>";
    const recipientId = "<%= targetUserId %>";
</script>

<script src="/js/chat.js"></script>
</body>
</html>

