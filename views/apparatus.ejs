<!DOCTYPE html>
<html lang="hy">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Medical apparatus</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" type="image/x-icon" href="https://cdn-icons-png.flaticon.com/512/6156/6156071.png">
</head>

<body>

<header>
    <nav>
        <a href="/users/home" class="logo">
            🦷 Dental Clinic
        </a>

        <ul>
            <li><a href="/users/home">Home</a></li>
            <li><a href="/users/register">Register</a></li>
            <li><a href="/users/login">Login</a></li>
            <li><a href="/users/users">Profile</a></li>
            <li><a href="/users/index">Blog</a></li>
            <li><a href="/users/About">About Us</a></li>
            <li><a href="/users/Contact">Contact</a></li>
        </ul>
    </nav>
</header>

<main class="apparatus-page">
    <section class="apparatus-container">
        <h1 class="mediaclText">Medical apparatus</h1>
        <p class="apparatus-subtitle">
            Advanced Diagnostics & Safety. Take a look at the modern medical equipment we use to provide world-class healthcare services.
        </p>

        <div class="apparatus-content">
            <div class="apparatus-text">

                <% posts.forEach(post => { %>
                    <div class="post-item" id="post-<%= post.id %>">
                        <h2><%= post.title %></h2>
                        <p><%= post.description %></p>

                        <% if (post.image) { %>
                            <img src="/media/<%= post.image %>" alt="Post Image">
                        <% } %>

                        <button class="delete-btn" data-id="<%= post.id %>">
                            Delete
                        </button>

                        <input class="commnetsInp" data-id="<%= post.id %>" type="text" placeholder="Write comment...">

                        <button class="send-btn" data-id="<%= post.id %>">
                            Send
                        </button>
                    </div>
                <% }) %>

            </div>
        </div>

    </section>
</main>

<footer>
    <ul>
        <li><a href="/users/about">About Us</a></li>
        <li><a href="/users/Contact">Contact</a></li>
        <li>Privacy</li>
    </ul>
    <p class="p_fist">© 2026 Dental Student Blog</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/js/home.js"></script>

</body>
</html>
