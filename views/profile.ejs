<!DOCTYPE html>
<html lang="hy">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="profiles_page.title"> profiles </title>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="icon" type="image/x-icon" href="https://cdn-icons-png.flaticon.com/512/6156/6156071.png">
</head>

<body>

<header>
    <a href="/users/home" class="logo" data-i18n="nav.logo">
        🦷 Dental Clinic
    </a>

    <div class="lang-dropdown">
        <button class="lang-dropbtn" id="currentLangBtn">🌐 HY</button>
        <div class="lang-dropdown-content">
            <a href="#" onclick="changeLanguage('hy')">Հայերեն</a>
            <a href="#" onclick="changeLanguage('en')">English</a>
            <a href="#" onclick="changeLanguage('ru')">Русский</a>
        </div>
    </div>

</header>

<main class="about-page">
    <section class="about-container">
        <div class="search_box">
            <h1 data-i18n="profiles_page.heading">Users and Doctors</h1>
            <input type="text" id="search-input" placeholder="Search doctors..." data-i18n-placeholder="profiles_page.search_placeholder">
        </div>

        <div class="instagram-grid">
            <% if (profiles && profiles.length > 0) { %>
                <% profiles.forEach(user => { %>
                    <a href="/confirm/all-profiles/<%= user.userId %>" class="user-card">
                        <div class="avatar-wrapper">
                            <img src="<%= user.photo ? '/media/' + user.photo : '/media/profile.jpg' %>"
                                 alt="<%= user.firstname %>"
                                 class="grid-avatar">
                        </div>
                        <div class="user-info">
                            <span class="user-fullname"><%= user.firstname %> <%= user.lastname %></span>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <p class="no-users" data-i18n="profiles_page.no_users">No users or doctors found.</p>
            <% } %>
        </div>

    </section>
</main>

<footer>
    <ul>
        <li><a href="/users/about" data-i18n="footer.about">About Us</a></li>
        <li><a href="/users/Contact" data-i18n="footer.contact">Contact</a></li>
        <li><a href="/users/privacy" style="color:#8e8e8e;" data-i18n="footer.privacy">Privacy</a></li>
    </ul>

    <p class="p_fist" data-i18n="footer.copy">
        © 2026 Dental Clinic
    </p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/js/profile.js"></script>

</body>
</html>
