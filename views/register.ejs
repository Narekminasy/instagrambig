<!DOCTYPE html>
<html lang="hy">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Register | Dental Clinic</title>

    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

<header>

    <nav>

        <a href="/users/home" class="logo">
            🦷 Dental Clinic
        </a>


        <ul>

            <li>
                <a href="/users/home">
                    Home
                </a>
            </li>

            <li>
                <a href="/users/register">
                    Register
                </a>
            </li>

            <li>
                <a href="/users/login">
                    Login
                </a>
            </li>

            <li>
                <a href="/users/users">
                    Profile
                </a>
            </li>

            <li>
                <a href="/users/index">
                    Blog
                </a>
            </li>

            <li>
                <a href="/users/About">
                    About Us
                </a>
            </li>

            <li>
                <a href="/users/Contact">
                    Contact
                </a>
            </li>

        </ul>


    </nav>

</header>




<main>


    <section class="form-box">


        <h1>
            Create Account
        </h1>


        <p>
            Join Dental Clinic Community
        </p>



        <input
                id="name"
                type="text"
                placeholder="Name"
        >



        <input
                id="age"
                type="number"
                placeholder="Age"
        >



        <input
                id="email"
                type="text"
                placeholder="Email"
        >



        <input
                id="password"
                type="password"
                placeholder="Password"
        >



        <button id="registerBtn">
            Register
        </button>



    </section>


</main>





<footer>


    <ul>

        <li>
            <a href="/users/about">
                About Us
            </a>
        </li>

        <li>
            <a href="/users/Contact">
                Contact
            </a>
        </li>

        <li style="color: white">
            Privacy
        </li>

    </ul>



    <p class="p_fist" style="color: white">
        © 2026 Dental Clinic
    </p>


</footer>





<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script src="/js/register.js"></script>


</body>

</html>