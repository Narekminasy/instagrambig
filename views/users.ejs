<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/users.css">
</head>

<body
        data-current-user-id="<%= (typeof user !== 'undefined' && user) ? user.id : '' %>"
        data-current-user-name="<%= (typeof myConfirmData !== 'undefined' && myConfirmData && myConfirmData.firstname) ? myConfirmData.firstname : 'Me' %>"
>

<header>
    <nav>
        <a href="/users/home" class="logo">
            🦷 Dental Clinic
        </a>
        <ul>
            <li><a href="/users/home">Home</a></li>
            <li><a href="/users/register">Register</a></li>
            <li><a href="/users/login">Login</a></li>
            <li><a href="/users/users">Profile</a></li>
            <li><a href="/users/index">Blog</a></li>
            <li><a href="/users/About">About Us</a></li>
            <li><a href="/users/Contact">Contact</a></li>
        </ul>
    </nav>
</header>

<div class="menu_box">
    <section class="menue">
        <div class="profile-actions">
            <% if (isOwnProfile) { %>
                <div class="dropdown-wrapper">
                    <button type="button" id="search_linsk">...</button>
                    <div id="dropdownMenu" class="sidebar-menu">
                        <a href="/confirm/all-users" class="menu-item" id="btnAllUsers">All Users Data</a>
                        <a href="/users/index" class="menu-item" id="btnAllProfiles">All Profiles</a>
                        <a href="/confirm/updatePhotos" class="menu-item" id="btnChangePhotos">Change Photos</a>
                        <a href="/users/apparatus" class="menu-item" id="btnChangePhotos">Medical Apparatus</a>
                        <a href="/users/logout" class="menu-item" id="logoutBTN">Logout</a>
                    </div>
                </div>
            <% } %>

            <% if (isOwnProfile && !confirmData) { %>
                <button type="button" id="confirmBtn" class="confirmBtn">Confirm Profile</button>
            <% } %>
        </div>
    </section>
</div>

<section class="users-container">
    <div class="users-profile">
        <div class="profile-top">
            <img src="<%= (confirmData && confirmData.photo) ? '/media/' + confirmData.photo : '/media/profile.jpg' %>" alt="Profile picture" class="profile-picture" id="profilePic">
            <img src="<%= (confirmData && confirmData.background) ? '/media/' + confirmData.background : '/media/backgroud.jpg' %>" alt="Background picture" class="backgroud-picture" id="backgroundPic">
            <div class="main-profile">
                <h1><%= (confirmData) ? confirmData.firstname + ' ' + confirmData.lastname : 'Your Blogs' %></h1>

                <h2 class="doc-address">📍 Address: <%= (confirmData && confirmData.address) ? confirmData.address : 'Address not specified' %></h2>
                <h2 class="doc-phone">📞 Phone: <%= (confirmData && confirmData.phone) ? confirmData.phone : 'Phone not specified' %></h2>
            </div>
        </div>

        <% if (isOwnProfile && !confirmData) { %>
            <div id="editFormContainer">
                <h3>Confirm Profile</h3>
                <form id="profileForm">
                    <div>
                        <label for="firstname">Firstname:</label>
                        <input type="text" id="firstname" required>
                    </div>
                    <div>
                        <label for="lastname">Lastname:</label>
                        <input type="text" id="lastname" required>
                    </div>

                    <div>
                        <label for="address">Address:</label>
                        <input type="text" id="address" placeholder="Isahakyan street 1/1" required>
                    </div>
                    <div>
                        <label for="phone">Phone:</label>
                        <input type="text" id="phone" placeholder="000.00000" required>
                    </div>

                    <div>
                        <label for="photoInput">Photo:</label>
                        <input type="file" id="photoInput" accept="image/*" required>
                    </div>
                    <div>
                        <label for="backgroundInput">Background:</label>
                        <input type="file" id="backgroundInput" accept="image/*" required>
                    </div>
                    <div>
                        <label for="diplomyInput">Diploma:</label>
                        <input type="file" id="diplomyInput" accept="image/*" required>
                    </div>
                    <div>
                        <button type="submit">Send Data</button>
                    </div>
                </form>
            </div>
        <% } %>

        <% if (isOwnProfile) { %>
            <div id="changePhotosContainer">
                <h3>Update Photos</h3>
                <form id="changePhotosForm">
                    <div>
                        <label for="updatePhoto">Photo:</label>
                        <input type="file" id="updatePhoto" accept="image/*" required>
                    </div>
                    <div>
                        <label for="updateBackground">Background:</label>
                        <input type="file" id="updateBackground" accept="image/*" required>
                    </div>
                    <div>
                        <button type="submit">Update</button>
                    </div>
                </form>
            </div>
        <% } %>
    </div>

    <% if (!isOwnProfile && confirmData) { %>
        <a href="/users/chat/<%= confirmData.userId || confirmData.id %>" class="btn-chat" style="padding: 10px 20px; background: #007bff; color: white; text-decoration: none; border-radius: 5px; display: inline-block; margin-top: 10px;">
            Send Message
        </a>
    <% } %>
</section>

<div class="ownPost">
    <h1 class="blogsWorld">BLOGS</h1>
    <% posts.forEach(post => { %>
        <div class="post-item" id="post-<%= post.id %>">
            <h2><%= post.title %></h2>
            <p><%= post.description %></p>
            <% if (post.image) { %>
                <img src="/media/<%= post.image %>" alt="Post Image">
            <% } %>
            <button class="delete-btn" data-id="<%= post.id %>">Delete</button>
        </div>
    <% }) %>
</div>

<div class="chat-window" id="chatWindow" data-recipient-id="<%= (confirmData) ? (confirmData.userId || confirmData.id || '') : '' %>">
</div>


<footer>


    <ul>

        <li>
            <a href="/users/about">
                About Us
            </a>
        </li>

        <li>
            <a href="/users/Contact">
                Contact
            </a>
        </li>

        <li>
            <a href="/users/privacy">
                Privacy
            </a>
        </li>

    </ul>



    <p class="p_fist">
        © 2026 Dental Clinic
    </p>


</footer>


<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/users.js"></script>

</body>
</html>
