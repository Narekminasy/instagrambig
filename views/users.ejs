<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="profile_page.title">User Profile</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/users.css">
    <link rel="icon" type="image/x-icon" href="https://cdn-icons-png.flaticon.com/512/6156/6156071.png">
</head>

<body
        data-current-user-id="<%= (typeof user !== 'undefined' && user) ? user.id : '' %>"
        data-current-user-name="<%= (typeof myConfirmData !== 'undefined' && myConfirmData && myConfirmData.firstname) ? myConfirmData.firstname : 'Me' %>"
>

<header>
    <nav>
        <a href="/users/home" class="logo" data-i18n="nav.logo">
            🦷 Dental Clinic
        </a>

        <div class="lang-dropdown">
            <button class="lang-dropbtn" id="currentLangBtn">🌐 HY</button>
            <div class="lang-dropdown-content">
                <a href="#" onclick="changeLanguage('hy')">Հայերեն</a>
                <a href="#" onclick="changeLanguage('en')">English</a>
                <a href="#" onclick="changeLanguage('ru')">Русский</a>
            </div>
        </div>


        <ul>
            <li><a href="/users/home" data-i18n="nav.home">Home</a></li>
            <li><a href="/users/register" data-i18n="nav.register">Register</a></li>
            <li><a href="/users/login" data-i18n="nav.login">Login</a></li>
            <li><a href="/users/users" data-i18n="nav.profile">Profile</a></li>
            <li><a href="/users/index" data-i18n="nav.blog">Blog</a></li>
            <li><a href="/users/About" data-i18n="nav.about">About Us</a></li>
            <li><a href="/users/Contact" data-i18n="nav.contact">Contact</a></li>
        </ul>
    </nav>
</header>

<div class="menu_box">
    <section class="menue">
        <div class="profile-actions">
            <% if (isOwnProfile) { %>
                <div class="dropdown-wrapper">
                    <button type="button" id="search_linsk">...</button>
                    <div id="dropdownMenu" class="sidebar-menu">
                        <a href="/confirm/all-users" class="menu-item" id="btnAllUsers" data-i18n="profile_page.all_users">All Users Data</a>
                        <a href="/users/index" class="menu-item" id="btnAllProfiles" data-i18n="profile_page.all_profiles">All Profiles</a>
                        <a href="/confirm/updatePhotos" class="menu-item" id="btnChangePhotos" data-i18n="profile_page.change_photos">Change Photos</a>
                        <a href="/users/apparatus" class="menu-item" id="btnChangePhotos" data-i18n="profile_page.apparatus">Medical Apparatus</a>
                        <a href="javascript:void(0);" class="menu-item" id="btnDeleteUser" data-i18n="profile_page.delete_user">Delete</a>
                        <a href="/users/logout" class="menu-item" id="logoutBTN" data-i18n="profile_page.logout">Logout</a>
                    </div>
                </div>
            <% } %>


            <% if (isOwnProfile && !confirmData) { %>
                <button type="button" id="confirmBtn" class="confirmBtn" data-i18n="profile_page.confirm_btn">Confirm Profile</button>
            <% } %>
        </div>
    </section>
</div>

<section class="users-container">
    <div class="users-profile">
        <div class="profile-top">
            <img src="<%= (confirmData && confirmData.photo) ? '/media/' + confirmData.photo : '/media/profile.jpg' %>" alt="Profile picture" class="profile-picture" id="profilePic">
            <img src="<%= (confirmData && confirmData.background) ? '/media/' + confirmData.background : '/media/backgroud.jpg' %>" alt="Background picture" class="backgroud-picture" id="backgroundPic">
            <div class="main-profile">
                <h1><%= (confirmData) ? confirmData.firstname + ' ' + confirmData.lastname : 'Your Blogs' %></h1>

                <h2 class="doc-address">
                    <span data-i18n="profile_page.address_label">📍 Address: </span>
                    <span><%= (confirmData && confirmData.address) ? confirmData.address : 'Address not specified' %></span>
                </h2>
                <h2 class="doc-phone">
                    <span data-i18n="profile_page.phone_label">📞 Phone: </span>
                    <span><%= (confirmData && confirmData.phone) ? confirmData.phone : 'Phone not specified' %></span>
                </h2>
            </div>
        </div>

        <% if (isOwnProfile && !confirmData) { %>
            <div id="editFormContainer">
                <h3 data-i18n="profile_page.form_title">Confirm Profile</h3>
                <form id="profileForm">
                    <div>
                        <label for="firstname" data-i18n="profile_page.label_firstname">Firstname:</label>
                        <input type="text" id="firstname" required>
                    </div>
                    <div>
                        <label for="lastname" data-i18n="profile_page.label_lastname">Lastname:</label>
                        <input type="text" id="lastname" required>
                    </div>

                    <div>
                        <label for="address" data-i18n="profile_page.label_address">Address:</label>
                        <input type="text" id="address" placeholder="Isahakyan street 1/1" required>
                    </div>
                    <div>
                        <label for="phone" data-i18n="profile_page.label_phone">Phone:</label>
                        <input type="text" id="phone" placeholder="000.00000" required>
                    </div>

                    <div>
                        <label for="photoInput" data-i18n="profile_page.label_photo">Photo:</label>
                        <input type="file" id="photoInput" accept="image/*" required>
                    </div>
                    <div>
                        <label for="backgroundInput" data-i18n="profile_page.label_bg">Background:</label>
                        <input type="file" id="backgroundInput" accept="image/*" required>
                    </div>
                    <div>
                        <label for="diplomyInput" data-i18n="profile_page.label_diploma">Diploma:</label>
                        <input type="file" id="diplomyInput" accept="image/*" required>
                    </div>
                    <div>
                        <button type="submit" data-i18n="profile_page.btn_send">Send Data</button>
                    </div>
                </form>
            </div>
        <% } %>

        <% if (isOwnProfile) { %>
            <div id="changePhotosContainer">
                <h3 data-i18n="profile_page.update_photos_title">Update Photos</h3>
                <form id="changePhotosForm">
                    <div>
                        <label for="updatePhoto" data-i18n="profile_page.label_photo">Photo:</label>
                        <input type="file" id="updatePhoto" accept="image/*" required>
                    </div>
                    <div>
                        <label for="updateBackground" data-i18n="profile_page.label_bg">Background:</label>
                        <input type="file" id="updateBackground" accept="image/*" required>
                    </div>
                    <div>
                        <button type="submit" data-i18n="profile_page.btn_update">Update</button>
                    </div>
                </form>
            </div>
        <% } %>
    </div>

    <% if (!isOwnProfile && confirmData) { %>
        <a href="/users/chat/<%= confirmData.userId || confirmData.id %>" class="btn-chat" style="padding: 10px 20px; background: #007bff; color: white; text-decoration: none; border-radius: 5px; display: inline-block; margin-top: 10px;" data-i18n="profile_page.btn_chat">
            Send Message
        </a>
    <% } %>
    <% if (typeof user !== 'undefined' && user.role === 'adminGeneral') { %>
        <button type="button"
                class="btn-make-admin"
                data-id="<%= confirmData.userId || confirmData.id %>"
                style="padding: 10px 20px; background: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
            Make Admin
        </button>

        <button type="button"
                class="btn-delete-user"
                data-id="<%= confirmData.userId || confirmData.id %>"
                style="padding: 10px 20px; background: #dc3545; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
            Delete User
        </button>
    <% } %>
</section>




<div class="ownPost">
    <h1 class="blogsWorld" data-i18n="profile_page.blogs_title">BLOGS</h1>
    <% posts.forEach(post => { %>
        <div class="post-item" id="post-<%= post.id %>">
            <h2><%= post.title %></h2>
            <p><%= post.description %></p>
            <% if (post.image) { %>
                <img src="/media/<%= post.image %>" alt="Post Image">
            <% } %>
            <button class="delete-btn" data-id="<%= post.id %>" data-i18n="profile_page.btn_delete">Delete</button>
        </div>
    <% }) %>
</div>

<div class="chat-window" id="chatWindow" data-recipient-id="<%= (confirmData) ? (confirmData.userId || confirmData.id || '') : '' %>">
</div>

<footer>
    <ul>
        <li><a href="/users/about" data-i18n="footer.about">About Us</a></li>
        <li><a href="/users/Contact" data-i18n="footer.contact">Contact</a></li>
        <li><a href="/users/privacy" data-i18n="footer.privacy">Privacy</a></li>
    </ul>
    <p class="p_fist" data-i18n="footer.copy">
        © 2026 Dental Clinic
    </p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/users.js"></script>

</body>
</html>
